# --- Supabase Postgres bağlantısı ---
# Supabase Dashboard > Project Settings > Database > Connection string
# "Transaction" havuzlama modu (port 6543) — uygulamanın normal çalışması için.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# "Direct connection" (port 5432) — sadece `prisma db push` / migration çalıştırırken kullanılır.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xxxxx.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (fotoğraf yüklemeleri) ---
# Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role_anahtarini_buraya_yapistirin"

# --- Site adresi ---
# QR kodun yönlendireceği adres. Yerelde test ederken yerel ağ IP'niz,
# Vercel'e deploy ettiğinizde Vercel'in verdiği (veya kendi) alan adınız.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Demo yönetici hesabı (ilk kurulumda `npm run db:seed` ile oluşturulur) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
